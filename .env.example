# ---------------------------------------------------------------------------
# Database
#
# Leave DATABASE_URL unset to use a local SQLite file (./data/mise.db).
# That is fine for development, but on most hosts the filesystem is ephemeral,
# so the file is wiped on every redeploy. Set DATABASE_URL to a managed
# Postgres connection string in production to keep data across deploys.
#
# DATABASE_URL="postgres://user:password@host:5432/mise"
# ---------------------------------------------------------------------------
DATABASE_URL=""

# Session signing secret — REPLACE with a long random string before deploying.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-change-me-please-32chars"

# Optional: USDA FoodData Central API key for nutrition lookups beyond the
# bundled ingredient database. Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=""
