# ---------------------------------------------------------------------------
# Database
#
# Required. A PostgreSQL connection string. Schema and additive migrations
# run automatically on startup — no separate migration step needed.
#
# DATABASE_URL="postgres://user:password@host:5432/mise"
# ---------------------------------------------------------------------------
DATABASE_URL=""

# Session signing secret — REPLACE with a long random string before deploying.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-change-me-please-32chars"

# Optional: USDA FoodData Central API key for nutrition lookups beyond the
# bundled ingredient database. Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=""
